{
  "name": "sagentic",
  "version": "1.0.8",
  "description": "Production-grade autonomous AI agent platform optimized for Google Cloud Run, Neon pgvector, and Gemini/Cloudflare",
  "main": "dist/server.js",
  "bin": {
    "sagentic": "bin/sagentic.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "chat": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "react-engine",
    "cloud-run",
    "gemini",
    "cloudflare-workers-ai",
    "neon",
    "pgvector",
    "fastify"
  ],
  "author": "ShunyaPulse",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.24.0",
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
